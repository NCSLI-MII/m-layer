-- Data for Name: function; Type: TABLE DATA; Schema: public; Owner: postgres
--

COPY public.function (id, ml_name, py_function, py_names_in_scope, comments) FROM stdin;
FN1	ra_direct	lambda x: x	{}	\N
FN2	ra_conversion	lambda x: a*x	{'a'}	\N
FN3	in_conversion	lambda x: a*x + b	{'a', 'b'}	\N
FN4	bi_conversion	lambda x: z + y_ub if ( z := math.fmod(a*x - y_lb, y_ub - y_lb) ) < 0 else z + y_lb 	{'a', 'y_lb', 'y_ub'}	fmod(x, y) is equal to x - n*y, for some integer n, such that the result has the same sign as x and magnitude less than the range abs(y). 
FN5	cct_its90_abs_K_to_K	\N	\N	Placeholder for CCT advice
FN6	cct_its90_abs_C_to_C	\N	\N	Placeholder for CCT advice
FN7	cct_its90_dif_C_to_C	\N	\N	Placeholder for CCT advice
FN8	cct_its90_dif_K_to_K	\N	\N	Placeholder for CCT advice
\.


